<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Designer.WpfApp.Test" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageReference Include="Codeer.LowCode.Bindings.Blazor-ApexCharts.Designer" Version="0.23.0" />
    <PackageReference Include="Codeer.LowCode.Blazor.Extras.Designer" Version="0.0.17" />
    <PackageReference Include="System.Net.Http.WinHttpHandler" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="8.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.1.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" />
    <PackageReference Include="Codeer.LowCode.Blazor.Designer" Version="1.3.6" />
    <ProjectReference Include="..\AccountingApp.Client.Shared\AccountingApp.Client.Shared.csproj" />
    <ProjectReference Include="..\AccountingApp.Server.Shared\AccountingApp.Server.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <!-- AIチャット(CssChat)が埋め込むCSS仕様プロンプト。 -->
  <ItemGroup>
    <EmbeddedResource Include="Lib\AI\AppCss.md">
      <LogicalName>Designer.WpfApp.Lib.AI.AppCss.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <!-- AIチャット(ScriptChat)が埋め込むスクリプト仕様プロンプト。 -->
  <ItemGroup>
    <EmbeddedResource Include="Lib\AI\Scripts.md">
      <LogicalName>Designer.WpfApp.Lib.AI.Scripts.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Lib\AI\ScriptGuidelines.md">
      <LogicalName>Designer.WpfApp.Lib.AI.ScriptGuidelines.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Lib\AI\ScriptExtensions.md">
      <LogicalName>Designer.WpfApp.Lib.AI.ScriptExtensions.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Lib\AI\_ScriptApi.md">
      <LogicalName>Designer.WpfApp.Lib.AI._ScriptApi.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <!-- AIチャット(PageFrameChat)が埋め込むページフレーム仕様プロンプト。 -->
  <ItemGroup>
    <EmbeddedResource Include="Lib\AI\PageFrame.md">
      <LogicalName>Designer.WpfApp.Lib.AI.PageFrame.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <!-- AIチャット(レイアウト系)が埋め込むレイアウト仕様・ガイドライン。 -->
  <!-- AIチャット共通: JsonAbstract継承クラスのTypeFullName一覧(全レイアウト/モジュール/ページフレーム系で共有) -->
  <ItemGroup>
    <EmbeddedResource Include="Lib\AI\JsonAbstractTypeFullName.md">
      <LogicalName>Designer.WpfApp.Lib.AI.JsonAbstractTypeFullName.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <!-- AIチャット(DetailLayoutChat)が埋め込むレイアウト仕様。 -->
  <ItemGroup>
    <EmbeddedResource Include="Lib\AI\Layouts.md">
      <LogicalName>Designer.WpfApp.Lib.AI.Layouts.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Lib\AI\LayoutGuidelines.md">
      <LogicalName>Designer.WpfApp.Lib.AI.LayoutGuidelines.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <!-- AIチャット(OverallSettingsChat)が埋め込むモジュール設定仕様。 -->
  <ItemGroup>
    <EmbeddedResource Include="Lib\AI\ModuleDesign.md">
      <LogicalName>Designer.WpfApp.Lib.AI.ModuleDesign.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Lib\AI\_FieldCommon.md">
      <LogicalName>Designer.WpfApp.Lib.AI._FieldCommon.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Lib\AI\SearchConditions.md">
      <LogicalName>Designer.WpfApp.Lib.AI.SearchConditions.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>