// designer.settings.Development.json の雛形（セットアップ: このファイルを designer.settings.Development.json に
// コピーし、<REPO_ROOT> をリポジトリ絶対パスに置換する。実ファイルは Git 追跡外 — 経緯: docs/decisions/0025）
{
  "ConnectionStrings": {
    "BusinessAppSQLite": "Data Source=<REPO_ROOT>\\LocalData\\db\\business-app_v1.db;"
  },
  "CurrentDeployInfoName": "local",
  "DeployInfo": {
    "local": {
      "DeployMethod": "FileSystem",
      "Directory": "<REPO_ROOT>\\LocalData\\designs"
    }
  }
}
