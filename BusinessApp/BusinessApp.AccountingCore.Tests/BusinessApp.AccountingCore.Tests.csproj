<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- カバレッジのゲート（ADR-0012）。`dotnet test` を打つだけで計測と閾値判定が走る。
       AccountingCore は依存ゼロの純粋ドメインなので、到達不能なコードが原理的に無い。
       100% に届かないなら「テストしていないロジック」か「要らないコード」のどちらかである。
       SkipAutoProps: 未設定の init プロパティを穴に数えない。
       ExcludeByAttribute の CompilerGeneratedAttribute: record のコピーコンストラクタ
       （`with` を使わない型では呼ばれない、自分で書いていないコード）を除く。
       実測でラムダは 1 つも除外されないことを確認済み。 -->
  <PropertyGroup>
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <CoverletOutput>$(MSBuildThisFileDirectory)TestResults/</CoverletOutput>
    <Include>[BusinessApp.AccountingCore]*</Include>
    <SkipAutoProps>true</SkipAutoProps>
    <ExcludeByAttribute>CompilerGeneratedAttribute</ExcludeByAttribute>
    <Threshold>100</Threshold>
    <ThresholdType>line,branch</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.msbuild" Version="6.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BusinessApp.AccountingCore\BusinessApp.AccountingCore.csproj" />
  </ItemGroup>

</Project>
