<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- カバレッジのゲート（ADR-0012）。`dotnet test` を打つだけで計測と閾値判定が走る。
       AccountingCore は依存ゼロの純粋ドメインなので、到達不能なコードが原理的に無い。
       100% に届かないなら「テストしていないロジック」か「要らないコード」のどちらかである。
       SkipAutoProps: 未設定の init プロパティを穴に数えない。
       **ExcludeByAttribute は置かない。** CompilerGeneratedAttribute を除外すると
       record のコピーコンストラクタだけでなく async のステートマシンと yield のイテレータも
       まるごと計測から消え、100% が何も保証しなくなる（qa/03 L-07・ADR-0012 §3）。 -->
  <PropertyGroup>
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <CoverletOutput>$(MSBuildThisFileDirectory)TestResults/</CoverletOutput>
    <Include>[BusinessApp.AccountingCore]*</Include>
    <SkipAutoProps>true</SkipAutoProps>
    <Threshold>100</Threshold>
    <ThresholdType>line,branch</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.msbuild" Version="6.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- 記法規約の検査（ADR-0021 §4-2）。禁止形と .editorconfig の実効 severity を
         構文木と AnalyzerConfigSet で見る。**テストプロジェクトにだけ置く。**
         TestSupport に置くと、それを参照する SchemaVerifyCli（migrate.ps1 -Verify が呼ぶ
         実行ファイル）の出力に 9 MB の DLL が載る。版はリポジトリ内の他プロジェクトに揃えてある。 -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BusinessApp.AccountingCore\BusinessApp.AccountingCore.csproj" />
    <ProjectReference Include="..\BusinessApp.TestSupport\BusinessApp.TestSupport.csproj" />
  </ItemGroup>

</Project>
