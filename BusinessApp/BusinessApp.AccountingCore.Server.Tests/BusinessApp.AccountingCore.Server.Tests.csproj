<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- カバレッジのゲート（ADR-0012）。AccountingCore と同じ 100% を敷く。
       ここは DB と CLB に触る層なので「テストしにくいから外す」誘惑が働くが、
       本物の DDL に本物の SQL を流す土台（BusinessApp.TestSupport）がある以上、
       到達できないコードは残らない。届かないなら、それは要らないコードである。 -->
  <PropertyGroup>
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <CoverletOutput>$(MSBuildThisFileDirectory)TestResults/</CoverletOutput>
    <Include>[BusinessApp.AccountingCore.Server]*</Include>
    <SkipAutoProps>true</SkipAutoProps>
    <ExcludeByAttribute>CompilerGeneratedAttribute</ExcludeByAttribute>
    <Threshold>100</Threshold>
    <ThresholdType>line,branch</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.msbuild" Version="6.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BusinessApp.AccountingCore.Server\BusinessApp.AccountingCore.Server.csproj" />
    <ProjectReference Include="..\BusinessApp.TestSupport\BusinessApp.TestSupport.csproj" />
  </ItemGroup>

</Project>
