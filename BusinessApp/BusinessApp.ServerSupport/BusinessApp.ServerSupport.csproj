<Project Sdk="Microsoft.NET.Sdk">

  <!-- 部品をまたいで使う、サーバ側の下ごしらえ（ADR-0025 §2）。
       いま入っているのは DbValue だけである——DB から返る object? を C# の値に直す、
       会計でも取引先でもない SQLite の作法。

       **先回りの共通化をしない。** 2 つ以上の部品が実際に使うものだけをここへ出す。
       会計コアだけが使うもの（DbTransactionScope・AccountingTimeZone）は
       AccountingCore.Server に残してある。 -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- 候補の解決（DatabaseTimeZone.Resolve）は外に見せないが、検査はする。
       「見つからなければ落とす」——黙って UTC に落ちない——がこの型の肝である。 -->
  <ItemGroup>
    <InternalsVisibleTo Include="BusinessApp.ServerSupport.Tests" />
  </ItemGroup>

</Project>
