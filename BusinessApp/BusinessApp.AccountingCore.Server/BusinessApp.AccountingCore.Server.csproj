<Project Sdk="Microsoft.NET.Sdk">

  <!-- 会計コアのサーバ側（ADR-0008）。DB アクセス・保存時の関門・帳票 API を置く。
       CLB のサーバ資産に依存してよい層はここまでで、AccountingCore は依存ゼロを保つ。 -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BusinessApp.AccountingCore\BusinessApp.AccountingCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Codeer.LowCode.Blazor" Version="1.3.20" />
    <PackageReference Include="Codeer.LowCode.Blazor.DbAccess" Version="0.1.0" />
  </ItemGroup>

</Project>
