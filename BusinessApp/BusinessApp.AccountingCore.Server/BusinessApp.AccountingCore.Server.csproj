<Project Sdk="Microsoft.NET.Sdk">

  <!-- 会計コアのサーバ側（ADR-0008）。DB アクセス・保存時の関門・帳票 API を置く。
       CLB のサーバ資産に依存してよい層はここまでで、AccountingCore は依存ゼロを保つ。 -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- 会計コア専用の下ごしらえ（Shared/AccountingTimeZone）は外に見せないが、検査はする。 -->
  <ItemGroup>
    <InternalsVisibleTo Include="BusinessApp.AccountingCore.Server.Tests" />
  </ItemGroup>

  <!-- 取引先部品への参照（ADR-0025 §2）。計上時の焼き込みと、保存の関門の合成に要る。
       向きは会計コア → 取引先の一方通行である（ADR-0024 §4）。 -->
  <ItemGroup>
    <ProjectReference Include="..\BusinessApp.AccountingCore\BusinessApp.AccountingCore.csproj" />
    <ProjectReference Include="..\BusinessApp.Partners.Server\BusinessApp.Partners.Server.csproj" />
    <ProjectReference Include="..\BusinessApp.ServerSupport\BusinessApp.ServerSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Codeer.LowCode.Blazor" Version="1.3.20" />
    <PackageReference Include="Codeer.LowCode.Blazor.DbAccess" Version="0.1.0" />
  </ItemGroup>

</Project>
