// appsettings.Development.json の雛形（セットアップ: このファイルを appsettings.Development.json にコピーし、
// <REPO_ROOT> をリポジトリ絶対パスに置換する。実ファイルは Git 追跡外 — 経緯: docs/decisions/0025）
// API キー等の秘密は書かないこと。実キーは .NET User Secrets へ（docs/decisions/0024）。
{
  "ConnectionStrings": {
    "BusinessAppSQLite": "Data Source=<REPO_ROOT>\\LocalData\\db\\business-app_v1.db;"
  },
  "FileStorages": [
    {
      "Name": "Local",
      "FileStorageType": "FileSystem",
      "Directory": "<REPO_ROOT>\\LocalData\\storages"
    }
  ],
  "DesignFileDirectory": "<REPO_ROOT>\\LocalData\\designs",
  "FontFileDirectory": "<REPO_ROOT>\\LocalData\\font",
  "UseHotReload": true,
  "SqlLog": false,
  "CanScriptDebug": true,
  "IsLicenseAutoUpdate": true,
  "IsLicenseAuthenticationByDomain": false,
  "AISettings": {
    "Provider": "Mock",
    "ClaudeApiKey": "",
    "ClaudeModel": "claude-opus-4-8",
    "OpenAIEndPoint": "",
    "OpenAIKey": "",
    "ChatModel": "",
    "DocumentAnalysisEndPoint": "",
    "DocumentAnalysisKey": ""
  },
  "NtaInvoiceSettings": {
    "ApplicationId": ""
  },
  "MailSettings": {
    "Host": "",
    "Port": "",
    "SenderMailAddress": "",
    "Password": "",
    "SSL": ""
  }
}
