<Project Sdk="Microsoft.NET.Sdk">

  <!-- テストの土台。テストそのものは置かない（IsTestProject を立てない）。
       本物の DDL と初期データを使い捨ての SQLite に流す仕掛けだけを持つ。 -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- 記法規約の検査（ADR-0021 §4-2）。禁止形は構文木で見る。
         正規表現だと空白なし・改行またぎ・補間文字列の穴で見逃しと誤検知が起きる。
         リポジトリ内の他プロジェクト（Client / Server / Designer）と同じ版に揃えてある。 -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
    <PackageReference Include="Codeer.LowCode.Blazor" Version="1.3.20" />
  </ItemGroup>

</Project>
