#!/bin/sh
#
# コミット前の検証（ADR-0012）。
#
# 有効にする（clone 後に 1 回だけ）:
#   git config core.hooksPath tools/git-hooks
#
# .git/hooks ではなくここに置いてあるのは、フック自体を Git の追跡下に置いて
# レビューできるようにするため。--no-verify で迂回できるので、規律の代替ではなく
# 「うっかり」を防ぐ装置と位置づける。
set -e

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# **段数を数えない**（ADR-0012 の決定）。`n/8` を手で書くと、段を足すたびに全部書き直すことになり、
# 直し忘れた番号がそのまま残る。**実行時に数えて、総数は言わない。**
stage_no=0
stage() {
    stage_no=$((stage_no + 1))
    echo "[pre-commit] ${stage_no}. $1"
}

# 凍結されたファイル（適用済みマイグレーション・baseline）の変更を拒む。
# **壊れたことに気づくのは次に migrate.ps1 を流したとき**で、そのときはもう main に入っている。
# 1 秒で終わるので最初に置く（ADR-0020。実際に踏んだ記録は qa/02 のラウンド 40）。
stage "凍結ファイルの検査"
python tools/clb/check_frozen.py --selftest
python tools/clb/check_frozen.py

# 失うことを止める道具の自己検査。**守る道具にテストが無いと、書き換えたときに
# 「止めているつもりで素通り」になる。** 短いので、**壊れていたら最初に知りたい**——
# 前に置く（凍結ファイルの検査と同じ理由）。
# 1 つめはコマンド文字列を見るフック（.claude/settings.json の PreToolUse）、
# 2 つめは実際に消す直前に絶対パスで見る `trash.ps1` の保護判定。**守る対象の正典は 1 つ**
# （tools/claude/protected_paths.json）で、両方がそれを読めているかもここで確かめている。
# 3 つめは稼働 DB の退避と復元（ADR-0046）。**allow を出す根拠が
# 「消さない・戻す前に必ず退避する」なので、それを機械で表明できないと allow の前提が立たない。**
# 4 つめはワークツリーの稼働 DB の更新。**行き先を決める判定がここでしか守られていない**——
# 緩めると本体の稼働 DB を上書きしうるので、db_snapshot と同じ理由で載せる。
# 5 つめは sql.ps1 の DDL を拒む判定（ADR-0064）。**稼働 DB のスキーマを記録なしに動かせる経路を塞ぐ**判定で、
# 語彙を狭めても誰も気づかないので、検体で縛る。
# 6 つめは pre-merge-commit の「木が同じなら流さない」判定（ADR-0067）。**緩めると main に入る瞬間の検査が
# 黙って消える**ので、使い捨てのリポジトリで**本物の `git merge` に呼ばせる検体**を撃つ
# （**手で状態を作って直接呼ぶ形では、壊れていても緑になった**——qa/03 の L-63。**撃つ検体はあちらのファイルが持つ**）。
# **印字だけでなく、稼働 DB の同値検査と全段への委譲に切り株を置いて、流れたかどうかまで見る**
# ——**字を残したまま到達不能にする書き換え**は、印字を見るだけでは素通りする。
# **この段は全段へ倒れたマージからも流れる**（pre-merge-commit が `exec` する）ので、
# **あちらは外側のマージの `GITHEAD_*` と git のローカル環境変数を落としてから撃つ**。
# 7 つめは「docs の文書だけか」の判定（ADR-0068）。**緩めると、C# を触った回のミューテーションが黙って飛ぶ**。
# **判定そのものと、フックがその判定を使っている配線の両方を見る。**
stage "失うことを止める道具の自己検査"
python tools/claude/guard_delete.py --selftest
pwsh -NoProfile -File tools/claude/trash.ps1 -SelfTest
pwsh -NoProfile -File tools/clb/db_snapshot.ps1 -SelfTest
pwsh -NoProfile -File tools/clb/worktree_db.ps1 -SelfTest
pwsh -NoProfile -File tools/clb/sql.ps1 -SelfTest
python tools/git-hooks/pre_merge_commit_selftest.py
python tools/git-hooks/docs_only.py --selftest

# 作業コピーの改行が LF であること。**リポジトリに入る中身は .gitattributes が正規化する**ので
# 常に LF だが、**作業コピーだけがずれる**——Windows の Write ツールと python の write_text が
# CRLF を書くため。ずれたまま進むと、**文言層の C# に複数行の raw string literal があるとき**に
# `CSharpStyleTests` が `dotnet test` の段で落ち、**数分の往復が丸ごと無駄になる**。
# **`.cs` の中の単独 CR はあちらが見る**（ADR-0021 §4-3）。ここは全追跡ファイルの CRLF と混在を見る。**1 秒で終わるので前に置く。**
# **何を LF にすべきかは `.gitattributes` が決める**（この道具は拡張子の一覧を持たない）。
stage "改行の検査"
python tools/claude/normalize_eol.py --selftest
python tools/claude/normalize_eol.py --check

stage "秘密の検査"
python tools/docs/lint_secrets.py

stage "ドキュメント規約の検査"
# 検査そのものが空回りしていないかを先に確かめる（守る道具にはテストを付ける。前の各段と同じ作法）
python tools/docs/lint_docs.py --selftest
python tools/docs/lint_docs.py

stage "CLB デザインの検査"
# 検査そのものが空回りしていないかを先に確かめる（前の各段と同じ作法）。
# **緩めた変更を守るものが無かった**——D-05 と D-10 を絞ったとき、鳴らなくなることを
# 確かめる手が目視しか無かった（qa/02 R26-21）。
python tools/clb/lint_design.py --selftest
python tools/clb/lint_design.py

# **`-Mode Tests` の掃引そのものは載せない**（理由の現在形は ADR-0058 決定 9）が、
# **変異点の数え方を守る検査だけは載せる**——0.1 秒で済み、
# **ここが壊れると掃引が「生き残り 0」という最良の報告を返す**。
# **`-Mode Rows` の掃引は下の段に載っている**（ADR-0058 決定 9。開発者の決定。2026-09-20）。
python tools/clb/sql_mutate.py --selftest
# 計器の選択そのものの自己検査。**印字のほうは載せない**——フックは印字を読まないし、
# ここで印字しても「掃引を流すかどうか」はもう変えられない（コミットの直前だから）。
# **印字は検証の段で人が打つ**（31 §6・`cycle` スキル）。
python tools/clb/which_gates.py --selftest

stage "テスト・カバレッジ・スキーマ"
dotnet test BusinessApp.slnx --nologo -v q

# 行セットの差分で殺す掃引（ADR-0058）。**クエリの SQL を触った人が手で流し忘れても、ここで鳴る。**
# **載せる決定は開発者**（2026-09-20。旧 Q-27。ADR-0056 決定 7 が「生き残りを減らしてから諮る」と
# 約束していたもので、15 件まで落ちて全部に説明が付いたので諮った）。
# **`-Mode Tests`（分かかる）は載せない**——手で流す契機は docs/31 §6 が持つ。
# **`dotnet test` の直後に置くのは、ビルドを二度しないで済むからである**——
# **掃引は自分で `dotnet build` する**（`sql_sweep.ps1`）ので、順を入れ替えても壊れはしない。遅くなるだけである。
# **ラチェットは上下の両側で挟んである**——生き残りが減った日にも鳴る（ADR-0058 決定 6）。
stage "行セットの差分で殺す掃引"
pwsh -NoProfile -File tools/clb/sql_sweep.ps1 -Mode Rows

# 稼働 DB とスキーマ正典の同値検査（ADR-0020）。同値テストは「マイグレーションの書き忘れ」を
# 捕まえるが、稼働 DB そのもののずれ（スキーマの適用忘れ・手作業の混入・未適用の残り）は
# ここでしか捕まらない。ddl/ を変えたら、コミット前に migrate.ps1 -Apply で稼働 DB に当てておくこと。
# この段はデザイナ exe（LocalEnvironment.md）と稼働 DB がある前提（1 人 1 台の開発機運用）。
# 無い環境でコミットする事情ができたら、黙ってスキップさせず、この段の扱いを決め直すこと。
stage "稼働 DB とスキーマ正典の同値検査"
pwsh -NoProfile -File tools/clb/migrate.ps1 -Verify

# ミューテーションテストの段（ADR-0012 §8）。**中身は tools/git-hooks/mutation_stage.sh が持つ。**
# **ファイルに切り出してあるのは、検体から流せるようにするためである**——
# `docs_only.py --selftest` が `dotnet` を切り株に差し替えてあれを実際に流し、
# **docs の文書だけの回に 1 つも呼ばれないこと**と**そうでない回に 5 つとも呼ばれること**を見る（ADR-0068）。
stage "ミューテーションテスト"
sh tools/git-hooks/mutation_stage.sh

echo "[pre-commit] すべて緑"
