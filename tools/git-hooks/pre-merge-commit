#!/bin/sh
#
# マージが自動でコミットするとき、git は pre-commit ではなく **pre-merge-commit** を呼ぶ。
# これが無いと「main に入る瞬間だけ、どの段も通らない」状態になる（自己レビューの指摘。2026-08-27）。
#
# **これからコミットする木が、取り込むブランチ先端の木と同一なら、木から決まる段は流さない**
# （決定と理由は ADR-0067）。同じ木は、そのブランチの最終コミットの
# pre-commit が既に全段で検査している。**違うなら全段を流す**——
# main が先へ進んでいた合流がそれに当たり、**どの親の木でもない木**が履歴に入る。
# **判定できないとき（取り込む先端を 1 つに決められない・木を書けない・先端の木を引けない）も全段へ倒す。**
#
# **稼働 DB とスキーマ正典の同値検査だけは、木が同じでも流す**——稼働 DB は木の中に無いので、
# ブランチの最終コミットから時間が空くとずれうる（ADR-0064 の「コミットごとに突き合わせる」）。
#
# **取り込む先端は `GITHEAD_<sha>` 環境変数から取る。`MERGE_HEAD` は見ない——このフックからは見えないからである。**
# **git が `MERGE_HEAD` を書くのは「マージが止まったあと」**（衝突・`--no-commit`・フックが拒んだとき）で、
# **このフックが走る時点では、どの経路でもまだ無い。**
# **経路ごとの実測（誰が呼ばれ、何が渡るか）は qa/03 の L-63 が持つ。**
# **`MERGE_HEAD` で判定していた初版は、本物のマージでは軽い経路へ一度も入らなかった**（同）。
# **`GITHEAD_*` は git がマージ戦略へ渡すもので、githooks(5) の約束ではない。**
# 渡されなくなれば 0 個になり、**安全側（全段）へ倒れる**。
#
# **失うもの**: rebase の衝突解決・cherry-pick・revert・am・--no-verify で作られた先端は pre-commit を
# 通っていない。前はマージの全段がその唯一の網だったが、木が同じなら今は当たらない（ADR-0067 の帰結）。
#
# **この判定の検体は `pre_merge_commit_selftest.py` が持つ**——**本物の `git merge` に呼ばせ、
# 稼働 DB の同値検査と全段への委譲に切り株を置いて、流れたかどうかまで見る**（コミット前フックが毎回流す）。
#
# PRE_MERGE_COMMIT_EXPLAIN=1  判定だけ印字し、**何も流さずマージも止める**。
#                             **このスクリプト自身の終了コードは 全段=10／軽い経路=11**だが、
#                             **`git merge` 経由で見える終了コードは git の 1** である（git が自分の値で返す）。
#                             **軽い経路でも 0 を返さない**——返すと、本物のマージが
#                             `migrate.ps1 -Verify` を飛ばしたままコミットまで進んでしまう。
#                             本物のマージで打ったら `git merge --abort` で戻す

set -e

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# **軽い経路で流す段。** 印字と実行が同じ 1 つの字から出るようにしてある
# ——**印字だけ直して実行を落とす**（またはその逆）ができないようにするため。
verify_stage="tools/clb/migrate.ps1 -Verify"

full() {
    if [ "${PRE_MERGE_COMMIT_EXPLAIN:-}" = "1" ]; then
        echo "[pre-merge-commit] EXPLAIN: 全段"
        exit 10
    fi
    exec "$repo_root/tools/git-hooks/pre-commit"
}

# 取り込む先端が「ちょうど 1 つ」と言えるときだけ先へ進む。0 個（マージの外・git が渡さなくなった）も
# 2 個以上（オクトパス）も全段へ倒す。**判定できないものを「同じ」に倒さない。**
set -- $(env | sed -n 's/^GITHEAD_\([0-9a-f][0-9a-f]*\)=.*/\1/p')
if [ "$#" -ne 1 ]; then
    echo "[pre-merge-commit] 取り込む先端を 1 つに決められない（GITHEAD_* が $# 個） → 全段を流す"
    full
fi

index_tree=$(git write-tree 2>/dev/null) || { echo "[pre-merge-commit] これからコミットする木を書けない → 全段を流す"; full; }
branch_tree=$(git rev-parse "$1^{tree}" 2>/dev/null) || { echo "[pre-merge-commit] 取り込む先端の木を引けない（$1） → 全段を流す"; full; }

if [ "$index_tree" != "$branch_tree" ]; then
    echo "[pre-merge-commit] 木がブランチ先端と異なる（$index_tree ≠ $branch_tree） → 全段を流す"
    full
fi

echo "[pre-merge-commit] 木がブランチ先端と同一（$index_tree ＝ $branch_tree）"
echo "[pre-merge-commit] → 木から決まる段は流さない（そのブランチの最終コミットで検査済み。ADR-0067）"
echo "[pre-merge-commit]    飛ばした段: pre-commit の全段（一覧は tools/README の表）から $verify_stage を除いたもの"
echo "[pre-merge-commit] → 軽い経路で流す段: $verify_stage（稼働 DB は木の中に無い）"
if [ "${PRE_MERGE_COMMIT_EXPLAIN:-}" = "1" ]; then
    echo "[pre-merge-commit] EXPLAIN: 軽い経路"
    exit 11  # **0 を返さない**——返すとマージが $verify_stage を飛ばして成立する
fi
pwsh -NoProfile -File $verify_stage

echo "[pre-merge-commit] 緑（軽い経路）"
