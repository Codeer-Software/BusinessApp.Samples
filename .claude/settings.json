{
    "_README": "Claude Code の恒久許可リスト（Git 追跡・ポータブル分のみ）。マシン固有の絶対パスを含む許可（デザイナ exe の各 CLI・参照リポジトリ）とフックは、Git 追跡外の settings.local.json に置く（雛形: settings.local.json.sample）。このファイルには絶対パス・ユーザー名・秘密情報を絶対に書かない（公開リポジトリのため）。不足が出たら追記して育てる。",
    "_README_attribution": "コミットメッセージと PR 本文に Claude の署名とセッション URL を付けない。公開リポジトリなので、セッション URL のような外部識別子を履歴に残さない方針。",
    "attribution": {
        "commit": "",
        "pr": "",
        "sessionUrl": false
    },
    "permissions": {
        "allow": [
            "Read",
            "Grep",
            "Glob",
            "Write",
            "Edit",
            "WebSearch",
            "WebFetch",
            "Bash(dotnet:*)",
            "Bash(git:*)",
            "Bash(gh:*)",
            "Bash(python:*)",
            "Bash(py:*)",
            "Bash(pwsh:*)",
            "Bash(powershell:*)",
            "Bash(ls:*)",
            "Bash(cat:*)",
            "Bash(head:*)",
            "Bash(tail:*)",
            "Bash(wc:*)",
            "Bash(find:*)",
            "Bash(grep:*)",
            "Bash(rg:*)",
            "Bash(sed:*)",
            "Bash(awk:*)",
            "Bash(sort:*)",
            "Bash(uniq:*)",
            "Bash(diff:*)",
            "Bash(echo:*)",
            "Bash(mkdir:*)",
            "Bash(cp:*)",
            "Bash(mv:*)",
            "Bash(touch:*)",
            "Bash(zip:*)",
            "Bash(unzip:*)",
            "Bash(curl:*)",
            "PowerShell(Get-ChildItem:*)",
            "PowerShell(Get-Content:*)",
            "PowerShell(Test-Path:*)",
            "PowerShell(Get-Item:*)",
            "PowerShell(New-Item:*)",
            "PowerShell(Copy-Item:*)",
            "PowerShell(Move-Item:*)",
            "PowerShell(Get-Process:*)",
            "PowerShell(Stop-Process:*)",
            "PowerShell(Get-NetTCPConnection:*)",
            "PowerShell(Invoke-WebRequest:*)",
            "PowerShell(Compress-Archive:*)",
            "PowerShell(Expand-Archive:*)",
            "mcp__claude-in-chrome"
        ],
        "ask": [
            "Read(**/designer.settings.Development.json)",
            "Edit(**/designer.settings.Development.json)",
            "Read(**/appsettings.Development.json)",
            "Edit(**/appsettings.Development.json)",
            "Bash(rm:*)",
            "Bash(rmdir:*)",
            "Bash(del:*)",
            "PowerShell(Remove-Item:*)",
            "PowerShell(Clear-Content:*)"
        ],
        "deny": [
            "Bash(git push:*)",
            "PowerShell(git push:*)",
            "Read(**/secrets.json)",
            "Read(**/*.pfx)",
            "Read(**/*.snk)"
        ]
    }
}
